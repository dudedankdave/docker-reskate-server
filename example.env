# Copy to .env (or common.env) and adjust. Unset/empty = leave the value already in
# /data/ReSkateServer.json (or the server default) untouched.
# Values containing '#' or an apostrophe must be double-quoted.

# --- Per-server (set these in each serverN.env when running several servers) ---
SERVER_NAME="My ReSkate Server - 24/7"   # 1-64 ASCII letters, numbers, spaces and - _ / [ ] ( ); other characters are cleaned automatically
MAP=Industrial Zone                       # displayName from the map mod's reskate-levels.json
# MAP_POOL=San Vansterdam,Isle of Grom,Skate2Map   # maps players vote between / the rotation uses (empty = all maps, off = clear)
# MAP_ROTATION_MINUTES=0                          # change the map on a timer, 0 = off
PORT=12400                                # only used with USE_STEAM_RELAY=false (open it, UDP)
QUERY_PORT=12401                          # server browser / A2S queries
# STEAM_TOKEN=                                          # keeps the same Steam ID across restarts (join code may still change), one per server (steamcommunity.com/dev/managegameservers, App ID 3354750)

# --- Access ---
SERVER_PASSWORD=                          # "off" clears an existing password
LISTED=true
MAX_PLAYERS=100
ADMINS=                                   # comma-separated SteamID64s
BANS=                                     # id[:name],id[:name] (kept in /data/data/bans.json)
# GLOBAL_BANS=true                           # turn away players the ReSkate team banned
WELCOME_MESSAGE="Welcome!"                # "off" clears it
# CHAT_COLOR="#8E5CFF"                       # server badge/name colour in chat (quote it: # starts a comment)
# CHAT_TEXT_COLOR="#D9C8FF"                  # server chat text colour
# RESERVED=                                  # SteamID64s who (like admins) can join on top of MAX_PLAYERS

# --- Gameplay ---
NOCLIP=true
NO_BAIL=true
BOOSTS=true
ENFORCE_TUNING=true
OBJECT_PLACEMENT=everyone                 # everyone | admins | nobody
# OBJECT_LIMIT=100                           # objects each player may place, 0 = no limit
# OBJECT_SCALING=true                        # let players resize the objects they place
# BONE_SCALE_LIMIT=2                         # most a mod may resize a skater's bones for others (big heads), 1-8, 0 = no limit; 1 also flattens skater height
PARTIES=true
PARTY_SIZE=8
ANNOUNCE_THROWDOWNS=true
# AFK_KICK_MINUTES=0                         # remove players away this long (1-1440), 0 = never
# SYNC_EFFECTS=true                          # players see each other's sparks, dust and trails
ACTIVITY_LOG=true
AUTO_UPDATE=false                         # true = let ReSkate 1.1.4+ replace its own binary inside the container (default off here: pull a new image)

# --- Anti-cheat ---
SPEED_CHECK=warn                          # off | warn | kick
SCORE_CHECK=warn                          # off | warn | kick
SCORE_ALLOW=

# --- Voice ---
VOICE_CHAT=true
VOICE_RANGE=300

# --- Network ---
# USE_STEAM_RELAY=true                       # false = players connect straight to PORT (UDP, must be open), lower ping
# SEND_RATE=900                              # most KB/s sent to one player, 128-16384 (about 1100 is what reaches players via Steam relays)
# CROWD_BUDGET=600                           # position updates/s per player, 0 = no limit (only matters in crowds)
# PACK_MS=10                                 # ms a message may wait to share a packet, 0-50
# FINGER_DISTANCE=25                         # metres beyond which fingers are not sent, 0 = always
# STEAM_DEBUG=false                          # log Steam networking details
DISTANCE_FULL_RATE_RETURN=50
DISTANCE_HALF_RATE_START=60
DISTANCE_HALF_RATE_RETURN=150
DISTANCE_LOW_RATE_START=170

# --- Voting ---
VOTE_MAP_ENABLED=false
VOTE_MAP_PERCENT=60
VOTE_KICK_ENABLED=false
VOTE_KICK_PERCENT=60
VOTE_TIME_OF_DAY_ENABLED=false
VOTE_TIME_OF_DAY_PERCENT=50
VOTE_SECONDS=30
VOTE_COOLDOWN_SECONDS=60

# --- Parks / layers ---
PARK_CONSTRUCTION=skatepark_01
PARK_HISTORIC=megapark_05
PARK_FINANCIAL=flumppark_08
WORLD_LAYER_SYNC=false
LAYERS=                                   # key=on|off|default,key=on

# Discord webhook (per server): console output + "UPDATE AVAILABLE" announcements.
# DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/<id>/<token>   # admin feed: everything + update messages (older name: DISCORD_WEBHOOK)
# DISCORD_WEBHOOK_USER=https://discord.com/api/webhooks/<id>/<token>    # user feed: joins, leaves, throwdowns only
# DISCORD_MENTION_IDS=123456789012345678,234567890123456789   # pinged on the update messages only
# DISCORD_CONSOLE=true                                        # false = admin feed: update messages only
# DISCORD_USERNAME=                                           # default: SERVER_NAME

# Thunderstore mods/maps (per server), installed into /data/Mods on every start.
# MODS=zeex64-Full_Skate_3_Map,brassy-Skate2Map   # Owner-Name (latest) | Owner-Name-1.2.3 (pinned) | package URL
# MODS_UPDATE=true                                 # false = keep installed versions
