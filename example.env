# Copy to .env (or common.env) and adjust. Unset/empty = leave the value already in
# /data/ReSkateServer.json (or the server default) untouched.
# Values containing '#' or an apostrophe must be double-quoted.

# --- Per-server (set these in each serverN.env when running several servers) ---
SERVER_NAME="My ReSkate Server - 24/7"   # 1-64 ASCII letters, numbers, spaces and - _ / [ ] ( ); other characters are cleaned automatically
MAP=Industrial Zone                       # displayName from the map mod's reskate-levels.json
# MAP_POOL=San Vansterdam,Isle of Grom,Skate2Map   # maps players vote between / the rotation uses (empty = all maps, off = clear)
# MAP_ROTATION_MINUTES=0                          # change the map on a timer, 0 = off
# MAP_LATEST_VERSIONS=false                       # ReSkate 2.0.7+: hold players to the newest Thunderstore version of each custom map
# MAP_LATEST_CHECK_MINUTES=60                     # how often that check runs
# MAP_ROTATION_VOTE=false                        # ReSkate 2.0.7+: players vote for the next map when the rotation time is up (needs MAP_ROTATION_MINUTES)
# MAP_ROTATION_VOTE_SECONDS=30                   # how long that vote runs, 10-120
# MAP_ROTATION_EXTEND_MINUTES=15                 # minutes a map gets when players choose to stay, 0 = staying is not offered
# MAP_ROTATION_ANNOUNCE=true                     # tell players how many minutes the map has left
PORT=12400                                # only used with USE_STEAM_RELAY=false (open it, UDP)
QUERY_PORT=12401                          # server browser / A2S queries
# STEAM_TOKEN=                                          # keeps the same Steam ID across restarts (join code may still change), one per server (steamcommunity.com/dev/managegameservers, App ID 3354750)

# --- Access ---
SERVER_PASSWORD=                          # "off" clears an existing password
LISTED=true
MAX_PLAYERS=100
ADMINS=                                   # comma-separated SteamID64s
BANS=                                     # id[:name],id[:name] (kept in /data/data/bans.json)
# GLOBAL_BANS=true                           # turn away players the ReSkate team banned
WELCOME_MESSAGE="Welcome!"                # "off" clears it
# CHAT_COLOR="#8E5CFF"                       # server badge/name colour in chat (quote it: # starts a comment)
# CHAT_TEXT_COLOR="#D9C8FF"                  # server chat text colour
# RESERVED=                                  # SteamID64s who (like admins) can join on top of MAX_PLAYERS

# --- Gameplay ---
NOCLIP=true
NO_BAIL=true
BOOSTS=true
ENFORCE_TUNING=true
OBJECT_PLACEMENT=everyone                 # everyone | admins | nobody
# OBJECT_LIMIT=100                           # objects each player may place, 0 = no limit
# OBJECT_SCALING=true                        # let players resize the objects they place
# BONE_SCALE_LIMIT=2                         # most a mod may resize a skater's bones for others (big heads), 1-8, 0 = no limit; 1 also flattens skater height
# BONE_REACH_LIMIT=1                         # metres a skater's bone may be from its parent for others, 0.5-20, 0 = no limit
PARTIES=true
PARTY_SIZE=8
ANNOUNCE_THROWDOWNS=true
# ANNOUNCE_KICKS=true                       # say admin kicks and bans in chat (done by the image)
# WORD_WARNINGS=3                            # warnings for blocked chat words before a kick, 0-10, 0 = never
# AFK_KICK_MINUTES=0                         # remove players away this long (1-1440), 0 = never
# KICK_MINUTES=restart                       # ReSkate 2.0.8+: how long an admin kick lasts (1-1440 min), restart = until the restart
# SYNC_EFFECTS=true                          # players see each other's sparks, dust and trails
# GLOBAL_WORD_FILTER=true                    # the ReSkate team's chat word lists
# WORDS_FILTERED=                            # own filtered words, comma-separated (off = none)
# WORDS_BLOCKED=                             # own blocked words, comma-separated (off = none)
ACTIVITY_LOG=true
UPDATE_MODE=pinned                        # pinned = the image's version | auto = install new releases into /data/server
# UPDATE_POLICY=timed                       # auto: instant | timed | ask | scheduled
# UPDATE_COUNTDOWN=10                       # minutes of in-game warning (skipped when nobody is on)
# UPDATE_SCHEDULE=04:00                     # scheduled: UTC, or e.g. "sat,sun 04:00"
# DISCORD_BOT_TOKEN=                        # ask: bot that posts the approval and reads ✅/❌
# DISCORD_APPROVAL_CHANNEL=                 # ask: channel id for it

# --- Anti-cheat ---
SPEED_CHECK=warn                          # off | warn | kick
SCORE_CHECK=warn                          # off | warn | kick
# BOARD_CHECK=warn                          # off | warn | kick: board kept on another player
SCORE_ALLOW=

# --- Voice ---
VOICE_CHAT=true
VOICE_RANGE=300

# --- Network ---
# USE_STEAM_RELAY=true                       # false = players connect straight to PORT (UDP, must be open), lower ping
# SEND_RATE=900                              # most KB/s sent to one player, 128-16384 (about 1100 is what reaches players via Steam relays)
# CROWD_BUDGET=600                           # position updates/s per player, 0 = no limit (only matters in crowds)
# PACK_MS=10                                 # ms a message may wait to share a packet, 0-50
# FINGER_DISTANCE=25                         # metres beyond which fingers are not sent, 0 = always
# THREADS=0                                  # threads building player updates, 0 = auto (processors - 1, up to 8)
# STEAM_DEBUG=false                          # log Steam networking details
DISTANCE_FULL_RATE_RETURN=50
DISTANCE_HALF_RATE_START=60
DISTANCE_HALF_RATE_RETURN=150
DISTANCE_LOW_RATE_START=170

# --- Voting ---
VOTE_MAP_ENABLED=false
VOTE_MAP_PERCENT=60
VOTE_KICK_ENABLED=false
VOTE_KICK_PERCENT=60
# VOTE_KICK_MINUTES=5                      # ReSkate 2.0.8+: how long a vote kick lasts (1-1440 min), restart = until the restart
VOTE_TIME_OF_DAY_ENABLED=false
VOTE_TIME_OF_DAY_PERCENT=50
# VOTE_EXTEND_MAP_ENABLED=true                # ReSkate 2.0.7+: /vote extend adds time to the current map (needs MAP_ROTATION_MINUTES), on by default
# VOTE_EXTEND_MAP_PERCENT=50
VOTE_SECONDS=30
VOTE_COOLDOWN_SECONDS=60
# VOTE_MAP_SECONDS=0                         # per-vote run time / cooldown, 0 = the ones above (also _KICK_, _TIME_OF_DAY_, _EXTEND_MAP_)
# VOTE_MAP_COOLDOWN_SECONDS=0
# VOTE_MAP_MIN_PLAYERS=1                     # players who must be on before the vote can start
# VOTE_STARTER_YES=true                      # whoever starts a vote has voted yes
# VOTES_CUSTOM='[{"name": "restart", "description": "Reload the map", "command": "map {map}", "percent": 60}]'   # JSON, off = none
# POLLS=admins                               # off | admins | everyone  (/poll Question? | A | B)
# POLL_SECONDS=60

# --- Announcements ---
# ANNOUNCEMENTS="Join the Discord: discord.gg/xyz|Be nice to each other"   # | separated chat lines posted in turn, off = none
# ANNOUNCEMENT_INTERVAL_MINUTES=0            # minutes between them, 0 = off

# --- Chat commands ---
# COMMANDS='[{"name": "discord", "reply": "Join us: discord.gg/xyz"}]'   # JSON, off = none

# --- Parks / layers ---
PARK_CONSTRUCTION=skatepark_01
PARK_HISTORIC=megapark_05
PARK_FINANCIAL=flumppark_08
# PARK_MODS='[{"name": "street", "folder": "...", "map": "San Vansterdam", "key": "bam"}]'
# PARK_LIMIT_PARKS=3                        # park mods spawned at once, 1-16
# PARK_LIMIT_OBJECTS=512                    # their objects together, 1-1024
WORLD_LAYER_SYNC=false
LAYERS=                                   # key=on|off|default,key=on

# Discord webhooks (per server), as many as you like: WEBHOOK_URL_<n> + WEBHOOK_SCOPE_<n>, any suffix.
# Scopes (comma-separated): admin (up + join code, problems, updates, mods; pings), log (whole console),
# public (joins, leaves, throwdowns, update notices), chat (in-game chat), leaderboard (default: public),
# updates (new official ReSkate releases; set it on one server only), updates-admin (this
# server's update messages instead of admin; pings).
# WEBHOOK_URL_1=https://discord.com/api/webhooks/<id>/<token>
# WEBHOOK_SCOPE_1=admin,log
# WEBHOOK_URL_2=https://discord.com/api/webhooks/<id>/<token>
# WEBHOOK_SCOPE_2=chat
# DISCORD_MENTION_IDS=123456789012345678,234567890123456789   # pinged in admin/updates-admin, may approve updates
# DISCORD_USERNAME=                                           # default: SERVER_NAME

# Ranked play and leaderboard (per server).
# LEADERBOARD=true
# LEADERBOARD_INTERVAL=60            # minutes between chat and Discord posts
# LEADERBOARD_SIZE=5                 # players listed in chat
# LEADERBOARD_POINTS=10,6,4,2        # per throwdown place, last value for every later place
# LEADERBOARD_BOARDS=general,year,month,week,event   # which boards exist; events are opened by admins with /lb event start <name>
# LEADERBOARD_DISCORD=general,week,event,jam,spot,skate   # which boards the Discord post lists
# LEADERBOARD_INTERVALS=general=120,week=30,event=10   # chat post minutes per board kind (0 = never); LEADERBOARD_DISCORD_INTERVALS the same for Discord
# LEADERBOARD_PROPS_PER_DAY=5        # /props <player>: props a player may give per 24 hours (0 = off)
# LEADERBOARD_COMMANDS=true         # /top /rank /boards (+ admin /lb) in the server's commands
# ROLES_SCOPE=shared                # shared: one admin/mod/vip list for all servers mounting /shared | server: own list
# LEADERBOARD_SCOPE=shared          # shared: one board for all servers mounting /shared (else own) | server: own board
# LEADERBOARD_LEAGUE=ranked        # ranked: server forces the ranked rules | unranked: everyone scores, on separate Unranked boards

# Thunderstore mods/maps (per server), installed into /data/Mods on every start.
# MODS=zeex64-Full_Skate_3_Map,brassy-Skate2Map   # Owner-Name (latest) | Owner-Name-1.2.3 (pinned) | package URL
# MODS_UPDATE=true                                 # false = keep installed versions
# MODS_STORE=shared                                # shared: the volume at /mods (all servers) | a path: this server's own store
# MODS_MAX_GB=8                                    # largest package (download and unpacked) in GiB, 0 = no limit
